APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/fixmind
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET_EVIDENCE=fixmind-evidence
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=15
AI_PROVIDER=unconfigured
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSION=1536
AI_TIMEOUT_SECONDS=30
AI_RETRY_COUNT=2
AI_MAX_EVIDENCE_CHARS=30000
AI_COST_TRACKING_ENABLED=false
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
MIN_SUCCESS_RATE_SAMPLE=5
AI_RATE_LIMIT_PER_DAY=50
